#!/usr/bin/env bash
# Installs and configures HAProxy load balancer

apt-get update -y
apt-get install -y haproxy

# Enable HAProxy init script if needed
if [ -f /etc/default/haproxy ]; then
    sed -i "s/ENABLED=0/ENABLED=1/" /etc/default/haproxy
fi

# Configure HAProxy frontend and backend
if ! grep -q "frontend http_front" /etc/haproxy/haproxy.cfg; then
cat << 'EOF' >> /etc/haproxy/haproxy.cfg

frontend http_front
    bind *:80
    mode http
    default_backend http_back

backend http_back
    mode http
    balance roundrobin
    server 7312-web-01 35.177.228.239:80 check
    server 7312-web-02 18.133.156.57:80 check
EOF
fi

service haproxy restart
